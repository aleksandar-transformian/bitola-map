{
  "name": "bitola-map",
  "private": true,
  "version": "0.1.0",
  "description": "Битола — интерактивна илустрирана 3Д мапа од отворени податоци",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:fetch:osm": "node scripts/data/fetch-osm.mjs",
    "data:fetch:terrain": "node scripts/data/fetch-terrain.mjs",
    "data:fetch:overture": "node scripts/data/fetch-overture.mjs",
    "data:fetch": "npm run data:fetch:osm && npm run data:fetch:overture && npm run data:fetch:terrain",
    "data:build": "node scripts/data/build.mjs",
    "data": "npm run data:fetch && npm run data:build",
    "shot": "node scripts/dev/screenshot.mjs",
    "bench": "node scripts/dev/bench.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/neucha": "^5.3.0",
    "earcut": "^3.0.2",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "hyparquet": "^1.31.5",
    "hyparquet-compressors": "^1.1.2",
    "pngjs": "^7.0.0",
    "vite": "^7.3.8"
  }
}
